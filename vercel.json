{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "headers": [
    {
      "source": "/models/(.*).usdz",
      "headers": [{ "key": "Content-Type", "value": "model/vnd.usdz+zip" }]
    }
  ],
  "redirects": [
    {
      "source": "/qr",
      "destination": "/ar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
